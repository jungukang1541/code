# catch-all 메일이 최종적으로 모이는 Gmail 계정
MAIL_HOST=imap.gmail.com
MAIL_PORT=993
MAIL_USER=your-catchall-account@gmail.com
MAIL_PASS=your-16-digit-app-password

# 사용자가 메일을 받는 본인 도메인 (예: rkdwnsrn1@mydomain.com 의 mydomain.com 부분)
DOMAIN=mydomain.com

# 최근 몇 분 이내 메일만 검색할지 (기본 15분)
LOOKBACK_MINUTES=15

PORT=3000
